{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":timezone(Europe/Paris)",
    "group:monorepos",
    "group:recommended"
  ],
  "labels": ["dependencies"],
  "assignees": ["foXaCe"],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "lockFileMaintenance": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "labels": ["security", "dependencies"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Label Python dependency updates",
      "matchManagers": ["pip_requirements", "pep621", "pip-compile"],
      "addLabels": ["python"]
    },
    {
      "description": "Label GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"]
    },
    {
      "description": "Group lint & format tools (pip + pre-commit)",
      "matchPackageNames": ["ruff", "mypy", "bandit", "codespell"],
      "groupName": "lint & format tools"
    },
    {
      "description": "Automerge low-risk updates once CI is green",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Automerge GitHub Actions minor/patch/digest",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Never auto-merge language runtime version bumps (python, node) — always review",
      "matchDepNames": ["python", "node"],
      "automerge": false
    },
    {
      "description": "Manifest runtime floors: PR only, never automerge",
      "matchFileNames": ["custom_components/dreame_vacuum/manifest.json"],
      "automerge": false,
      "addLabels": ["python", "runtime-floor"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track runtime requirement floors in the Home Assistant manifest",
      "managerFilePatterns": ["/^custom_components/dreame_vacuum/manifest\\.json$/"],
      "matchStrings": [
        "\"(?<depName>[a-zA-Z0-9._-]+)(?:\\[[a-zA-Z0-9,._-]+\\])?>=(?<currentValue>[0-9][^\",<]*)"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ]
}
