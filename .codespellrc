[codespell]
# Skip certain files and directories - use comma-separated list
skip = *.js,*.json,*.yaml,*.yml,*.pyc,.git,.github,__pycache__,*.egg-info,.pytest_cache,.venv,venv,dist,build,PERFORMANCE_OPTIMIZATIONS.md,*/resources.py,*/_resources_data.py,*/_notification_images.py,*/dreame/const.py

# Ignore certain words that are legitimate or technical terms
# French words from documentation and code: valide,mot,projet,branche,chambre,manger,espace
# Variable names from code: aline,laf,vor,fpr,ore,tey,oce,vog
ignore-words-list = hass,nd,te,whe,ot,ue,ane,thn,bu,fo,tre,wya,vas,dnd,dout,valide,mot,projet,branche,clonez,formater,aline,laf,vor,fpr,ore,tey,oce,vog,chambre,manger,espace,objets,objet,normale,mouvement,bord,anormal

# Quiet level
quiet-level = 2
